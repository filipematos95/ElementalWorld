\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Comprehensive ODD 2020 Architectural Model Diagram of \texttt  {HybridEcosystem}.} The diagram illustrates the five structural levels: Level 1 (External Forcing and Parameter Inputs), Level 2 (Abiotic Soil Grid and Spatial Fields), Level 3 (Individual Agent Buffer and State Vector), Level 4 (Sequential Process Submodels with governing equations [P1]--[P10]), and Level 5 (Emergent System States and Logged Outputs). Arrow styles specify causality, exogenous forcing, stochastic draws, state transitions, and closed feedback loops.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:model_architecture}{{1}{11}{\textbf {Comprehensive ODD 2020 Architectural Model Diagram of \texttt {HybridEcosystem}.} The diagram illustrates the five structural levels: Level 1 (External Forcing and Parameter Inputs), Level 2 (Abiotic Soil Grid and Spatial Fields), Level 3 (Individual Agent Buffer and State Vector), Level 4 (Sequential Process Submodels with governing equations [P1]--[P10]), and Level 5 (Emergent System States and Logged Outputs). Arrow styles specify causality, exogenous forcing, stochastic draws, state transitions, and closed feedback loops}{figure.1}{}}
